# Sandbox AgentCore Runtime for demo_cpu_branching — a CPU Code-Interpreter-class microVM that
# HOSTS THE REAL CLAUDE CODE CLI (node 22 + @anthropic-ai/claude-code BAKED IN — the "prebaked"
# path). claude_code_generate.py sets prebaked=True for SANDBOX=agentcore-runtime and SKIPS
# install_cli, because streaming the multi-MB node/claude tarballs through write_file corrupts the
# binaries over the runtime transport. So the CLI must already be in the image.
#
# Build context MUST be this demo dir (it vendors sandbox_server_agent.py):
#   docker build -f deploy/Dockerfile.sandbox.cli -t <ecr>/acs-sandbox-cli:latest .
# Then push + register into a Runtime and point AGENTCORE_SANDBOX_RUNTIME_ARN (run.sh) at it:
#   aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin <ecr>
#   docker push <ecr>/acs-sandbox-cli:latest
#   # register via your deploy_cli_sandbox.py / create-agent-runtime with this image URI.
#
# The SWE checker is pure Python (import the agent's solution.py, run asserts), so beyond the CLI
# this needs nothing but a stdlib python3 + bedrock-agentcore. SANDBOX_PYLIB stays UNSET (the
# GPU/torch prepare path in sandbox_server_agent.py stays dormant).
FROM public.ecr.aws/docker/library/python:3.12-slim

# --- system deps + node 22 (NodeSource) ------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- the Claude Code CLI, baked to /usr/local/bin/claude (what ClaudeCodeHarness launches) -----
# `npm install -g` already creates a working `claude` launcher on PATH (current versions ship
# bin/claude.exe, not the old cli.js — so DON'T hand-symlink cli.js, it no longer exists). Just
# ensure /usr/local/bin/claude resolves to whatever npm installed (guard the self-symlink case
# where npm's global prefix already IS /usr/local).
RUN npm install -g @anthropic-ai/claude-code \
    && CB="$(command -v claude)" \
    && if [ "$CB" != "/usr/local/bin/claude" ]; then ln -sf "$CB" /usr/local/bin/claude; fi \
    && /usr/local/bin/claude --version

# --- the unprivileged 'agent' user the harness runs the CLI as (write_config chowns its .claude) --
RUN useradd -m -s /bin/bash agent

WORKDIR /app
RUN pip install --no-cache-dir bedrock-agentcore

# sandbox_server_agent.py is self-contained (stdlib + bedrock_agentcore, no relative imports), so
# copy it flat — it serves exec / write_file / read_file that the harness + checker drive.
COPY agentcore_slime_demo/sandbox_server_agent.py /app/sandbox_server_agent.py

ENV SANDBOX_WORKDIR=/workspace
EXPOSE 8080
CMD ["python", "-m", "sandbox_server_agent"]
