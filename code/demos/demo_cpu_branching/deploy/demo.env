# demo_cpu_branching — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
SUBSTRATE=microvm
PLATFORM=linux/arm64
IMAGES="${IMAGES:-cli:Dockerfile.sandbox.cli}"   # node 22 + the Claude Code CLI baked in
REPO_PREFIX="${NAME_PREFIX}-sandbox-"     # names deploy/deploy_branching.py uses
RUNTIME_PREFIX="${NAME_PREFIX}_sandbox_"
ARN_WIRING=arn
# VPC-mode Runtime + private endpoints + ONE SG->SG ingress rule so the in-sandbox CLI can dial back to
# the trainer's AnthropicAdapter (tcp 18021). Prints AGENTCORE_SANDBOX_RUNTIME_ARN + ADAPTER_PUBLIC_HOST.
DEPLOY_CMD="SKIP_BUILD=1 python3 deploy/deploy_branching.py"
