# demo_cpu_heartbeat — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
SUBSTRATE=microvm
PLATFORM=linux/arm64
IMAGES="${IMAGES:-cpu:Dockerfile.sandbox.cpu}"
REPO_PREFIX="${NAME_PREFIX}-heartbeat-"
RUNTIME_PREFIX="${NAME_PREFIX}_heartbeat_"
ARN_WIRING=arns          # overrides run.sh's baked K=2 AGENTCORE_SANDBOX_RUNTIME_ARNS with this demo's Runtime
DEFAULT_NOTE="baked shared K=2 acs_sandbox_cpu ARNs"
