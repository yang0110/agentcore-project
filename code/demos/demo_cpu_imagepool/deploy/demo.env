# demo_cpu_imagepool — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
SUBSTRATE=microvm
PLATFORM=linux/arm64
# The pool: one image per capability. Every default family routes to one of these three.
IMAGES="${IMAGES:-datasci:Dockerfile.sandbox.datasci scipy:Dockerfile.sandbox.scipy sklearn:Dockerfile.sandbox.sklearn}"
REPO_PREFIX="${NAME_PREFIX}-sandbox-"     # names deploy/deploy_imagepool.py uses
RUNTIME_PREFIX="${NAME_PREFIX}_sandbox_"
ARN_WIRING=by_image
# VPC-mode Runtimes (private endpoints) — deploy_imagepool.py does that wiring; images already pushed.
DEPLOY_CMD="SKIP_BUILD=1 python3 deploy/deploy_imagepool.py"
