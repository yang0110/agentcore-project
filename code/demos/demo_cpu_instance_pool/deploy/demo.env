# Sandbox tier: tier 3 (own Runtime, custom ~4 GB image, CPU Instance m5). See code/demos/README.md.
# demo_cpu_instance_pool — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
#
# A LARGE (~4 GB, > the 2 GB microVM cap) sandbox image on a CPU capacity-provider INSTANCE (m5),
# run as a WARM POOL: SANDBOX_POOL=N shared runtimeSessionIds -> N warm m5 instances, each episode a
# fresh isolated sub_session on one of them (CpuFarm, SANDBOX_FARM=cpu).
SUBSTRATE=instance
PLATFORM=linux/amd64                       # m5 Instance is x86_64
IMAGES="bigcpu:Dockerfile.sandbox.bigcpu"
REPO_PREFIX="${NAME_PREFIX}-sandbox-"      # names deploy/deploy_bigimage.py uses
RUNTIME_PREFIX="${NAME_PREFIX}_sandbox_"
ARN_WIRING=arn
# CPU capacity provider (CPU_INSTANCE, default m5.xlarge) + Runtime on it with SANDBOX_FARM=cpu.
DEPLOY_CMD="SKIP_BUILD=1 python3 deploy/deploy_bigimage.py"
CP_NAME="${NAME_PREFIX}_cpu_cp_bigimage"
DELETE_CP="${DELETE_CP:-1}"
PREPARE_POST=""
export DATASET="${DATASET:-deepscaler}"
DEFAULT_NOTE="no baked ARN — run 4_deploy_runtime.sh first"
