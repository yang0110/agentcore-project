# demo_cpu_tasks VARIANT=bigimage — a LARGE custom-Runtime sandbox image (well past the ~2 GB serverless microVM
# image cap), so it MUST run on an AgentCore capacity-provider Instance, not a Code Interpreter
# microVM. Same /invocations contract as deploy/Dockerfile.sandbox.cpu in the other demos — only the
# baked dependency stack is heavy (a real scientific / ML checker environment a microVM can't hold).
#
# Build NATIVE amd64 with the DEMO DIR as context (so agentcore_slime_demo/ is copied in):
#     docker build -f deploy/Dockerfile.sandbox.bigcpu -t acs-sandbox-bigcpu .
# then push to ECR and CreateAgentRuntime with a capacity provider (see deploy/deploy_bigimage.py).
#
# Why this can't be a microVM: torch (CPU) + the scientific stack below is multiple GB uncompressed —
# past the Code Interpreter image cap. The capacity-provider Instance has an instance-sized root disk,
# so the cap is your instance storage, not the microVM limit. (This is the CPU analogue of the GPU
# custom-Runtime path in demo_gpu_customruntime.)
FROM python:3.12-slim

# System packages a real checker might need (build tools + common native libs). These alone already
# push the image beyond a trivial slim base.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The heavy Python stack — this is the part that blows past the microVM image cap. torch CPU wheels +
# the scientific stack are several GB. Pin to keep builds reproducible.
RUN pip install --no-cache-dir \
        "torch==2.4.1" --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        numpy pandas scipy scikit-learn sympy \
        bedrock-agentcore

# The AgentCore Runtime server: sandbox_server_agent.py answers /invocations (write_file/exec/read_file)
# and /ping, identical to the small-image demos. Vendored under the demo's lib dir. We also ship the
# CPU shared-instance FARM (sandbox_cpu_farm + its fresh-env helper): with SANDBOX_FARM=cpu, episodes
# invoked under one shared runtimeSessionId (SANDBOX=agentcore-ray-farm on the client) all reuse this
# ONE warm instance — paying the ~60-80 s cold-boot ONCE — while each per-episode sub_session still
# gets a FRESH, fully-isolated environment (own workdir + HOME/TMPDIR/caches, wiped on close).
WORKDIR /app
COPY agentcore_slime_demo/sandbox_server_agent.py /app/sandbox_server_agent.py
COPY agentcore_slime_demo/sandbox_cpu_farm.py /app/sandbox_cpu_farm.py
COPY agentcore_slime_demo/sandbox_farm_env.py /app/sandbox_farm_env.py

# Select the CPU shared-instance farm (fresh env per sub_session). Baked into the image so a plain
# CreateAgentRuntime picks it up; still overridable via the runtime's environmentVariables.
ENV SANDBOX_FARM=cpu

EXPOSE 8080
CMD ["python", "/app/sandbox_server_agent.py"]
