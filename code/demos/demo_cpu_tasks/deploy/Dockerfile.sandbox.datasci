# Sandbox AgentCore Runtime — CUSTOM "datasci" image (DATASET=mixed capability-routing).
# Build context MUST be code/:
#   docker build -f code/demos/demo_cpu_tasks/deploy/Dockerfile.sandbox.datasci \
#       -t <ecr>/acs-sandbox-datasci:latest code/
#
# Identical to Dockerfile.sandbox.cpu (the same self-contained sandbox_server_agent.py exposing
# /invocations write_file/exec/read_file) EXCEPT it bakes in pandas + numpy. The DATASET=mixed `datasci`
# family's solution.py does `import pandas`, which the plain CPU image cannot satisfy — so its
# episodes are routed here by task.image="datasci" (see agentcore_slime_demo/sandbox.py
# _runtime_arn_for_image + AGENTCORE_SANDBOX_RUNTIME_ARN_BY_IMAGE). This is the one custom image in
# the otherwise-CPU mix; the pure-stdlib families keep Dockerfile.sandbox.cpu.
FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app
# bedrock-agentcore (the /invocations server) + the extra toolchain THIS image exists to provide.
RUN pip install --no-cache-dir bedrock-agentcore pandas numpy

# sandbox_server_agent.py is self-contained (stdlib + bedrock_agentcore, no relative imports), so
# copy it flat — no package, no __init__, nothing heavy.
COPY agentcore_slime_demo/sandbox_server_agent.py /app/sandbox_server_agent.py

ENV SANDBOX_WORKDIR=/workspace
EXPOSE 8080
CMD ["python", "-m", "sandbox_server_agent"]
