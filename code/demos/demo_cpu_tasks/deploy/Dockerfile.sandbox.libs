# Sandbox image "libs" — the stdlib CPU sandbox + pandas / scipy / scikit-learn, for the datasci / scipy /
# sklearn families (DATASET=libs, and the datasci rows of DATASET=mixed). Their tasks carry
# task.image = datasci | scipy | sklearn; run.sh maps all three tags to this one Runtime
# (AGENTCORE_SANDBOX_RUNTIME_ARN_BY_IMAGE). arm64 microVM image, well under the 2 GB cap.
# Build context = this demo dir (2_build_image.sh).
FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir bedrock-agentcore numpy pandas scipy scikit-learn

COPY agentcore_slime_demo/sandbox_server_agent.py /app/sandbox_server_agent.py

ENV SANDBOX_WORKDIR=/workspace
EXPOSE 8080
CMD ["python", "-m", "sandbox_server_agent"]
