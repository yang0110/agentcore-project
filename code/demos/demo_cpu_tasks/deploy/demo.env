# demo_cpu_tasks — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
SUBSTRATE=microvm
PLATFORM=linux/arm64
# cpu = the generic sandbox (every dataset); datasci = pandas image, only DATASET=mixed routes to it.
# Single-dataset runs can skip it: IMAGES=cpu:Dockerfile.sandbox.cpu bash 2_build_image.sh (same for 3/4/6).
IMAGES="${IMAGES:-cpu:Dockerfile.sandbox.cpu datasci:Dockerfile.sandbox.datasci}"
REPO_PREFIX="${NAME_PREFIX}-tasks-"
RUNTIME_PREFIX="${NAME_PREFIX}_tasks_"
ARN_WIRING=arns          # cpu -> AGENTCORE_SANDBOX_RUNTIME_ARNS; + ARN_BY_IMAGE {cpu,datasci} when both exist
PREPARE_POST="python3 $C_DEMO_DIR/verify_data.py"
DEFAULT_NOTE="baked shared K=2 acs_sandbox_cpu ARNs"

# ---- VARIANT=bigimage (was demo_cpu_bigimage) ---------------------------------------------------
# A LARGE (~4 GB, > the 2 GB microVM cap) sandbox image on a CPU capacity-provider INSTANCE (m5),
# warm-shared (one runtimeSessionId, fresh CpuFarm env per episode). Run every step with it:
#     VARIANT=bigimage bash 2_build_image.sh   (then 3_push_ecr.sh, 4_deploy_runtime.sh, 5_run.sh, 6_cleanup.sh)
if [ "${VARIANT:-}" = "bigimage" ]; then
  SUBSTRATE=instance
  PLATFORM=linux/amd64                       # m5 Instance is x86_64
  IMAGES="bigcpu:Dockerfile.sandbox.bigcpu"
  REPO_PREFIX="${NAME_PREFIX}-sandbox-"      # names deploy/deploy_bigimage.py uses
  RUNTIME_PREFIX="${NAME_PREFIX}_sandbox_"
  ARN_WIRING=arn
  # CPU capacity provider (CPU_INSTANCE, default m5.xlarge) + Runtime on it with SANDBOX_FARM=cpu.
  DEPLOY_CMD="SKIP_BUILD=1 python3 deploy/deploy_bigimage.py"
  CP_NAME="${NAME_PREFIX}_cpu_cp_bigimage"
  DELETE_CP="${DELETE_CP:-1}"
  PREPARE_POST=""
  export VARIANT DATASET="${DATASET:-deepscaler}"
  DEFAULT_NOTE="no baked ARN — run 4_deploy_runtime.sh first"
fi
