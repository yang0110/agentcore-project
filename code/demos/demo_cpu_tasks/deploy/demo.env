# Sandbox tier: tier 2 (our own Runtime, generic stdlib image, VPC) by DEFAULT; tier 1 (managed Code Interpreter, no image) opt-in with SANDBOX=agentcore. See code/demos/README.md.
# demo_cpu_tasks — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
#
# SANDBOX: agentcore-runtime (the only backend) — our OWN sandbox Runtimes, networkMode=VPC so the
# in-session harness can dial the adapter back. Two microVM images:
#   cpu   Dockerfile.sandbox.cpu   stdlib only (every dataset except the pandas/scipy/sklearn families)
#   libs  Dockerfile.sandbox.libs  + pandas / scipy / scikit-learn (task.image = datasci | scipy | sklearn)
# The managed Code Interpreter (SANDBOX=agentcore) was removed 2026-09-28: it has no route back to the
# adapter, so the agent loop would have to run in the trainer. It survives only as a probe
# (compare_backends.py). Build a subset with IMAGES=cpu:Dockerfile.sandbox.cpu if you never run libs/mixed.
SANDBOX="${SANDBOX:-agentcore-runtime}"
SUBSTRATE=microvm
PLATFORM=linux/arm64
IMAGES="${IMAGES:-cpu:Dockerfile.sandbox.cpu libs:Dockerfile.sandbox.libs}"
REPO_PREFIX="${NAME_PREFIX}-tasks-"
RUNTIME_PREFIX="${NAME_PREFIX}_tasks_"
ARN_WIRING=arns          # cpu -> AGENTCORE_SANDBOX_RUNTIME_ARNS; >1 image adds ..._ARN_BY_IMAGE (run.sh aliases libs)
PREPARE_POST="python3 $C_DEMO_DIR/verify_data.py"
DEFAULT_NOTE="baked shared K=2 acs_sandbox_cpu ARNs (stdlib datasets only)"

# VARIANT=terminalbench — the Terminal-Bench pool: ONE image + Runtime PER TASK (~229 fetched, 166 usable),
# built from terminalbench/tasks/ by terminalbench/deploy_terminalbench.py (each task's own Dockerfile +
# the AgentCore server layer, buildx --push, so step 3 only reports). Step 4 registers one Runtime per
# pushed image -> terminalbench/tasks/arn_by_image.json, which image_routing.py merges into the map for
# any run whose rows include Terminal-Bench. Its own runtime.terminalbench.env keeps deploy/runtime.env
# (the cpu/libs ARNs) intact. TB_LIMIT=2 to validate the pipeline first.
if [ "${VARIANT:-}" = terminalbench ]; then
  IMAGES=""
  REPO_PREFIX="${NAME_PREFIX}-tb-"
  RUNTIME_PREFIX="${NAME_PREFIX}_tb_"
  ARN_WIRING=by_image
  PREPARE_POST=""         # DATASET=terminalbench prepare fetches the corpus itself; oracle check = terminalbench/validate_oracle.py
  BUILD_CMD="{ [ -f terminalbench/tasks/manifest.json ] || python3 terminalbench/fetch_terminalbench.py; } && TB_NO_REGISTER=1 python3 terminalbench/deploy_terminalbench.py"
  PUSH_CMD="column -s, -t < terminalbench/tasks/images.csv | head -n 40; echo '(images were pushed by step 2)'"
  DEPLOY_CMD="python3 terminalbench/deploy_terminalbench.py"
  CLEANUP_CMD="python3 - <<'PY'
import json, sys; sys.path.insert(0, 'deploy'); import agentcore_deploy as d
import boto3
arns = json.load(open('terminalbench/tasks/arn_by_image.json'))
c = boto3.client('bedrock-agentcore-control', region_name=d.REGION)
for task, arn in arns.items():
    try: c.delete_agent_runtime(agentRuntimeId=arn.rsplit('/', 1)[1]); d.err(f'deleted {task}')
    except Exception as e: d.err(f'{task}: {e}')
PY"
fi

case "$SANDBOX" in
  agentcore-runtime|runtime)
    export SANDBOX ;;
  *) echo "!! demo_cpu_tasks: SANDBOX=$SANDBOX not supported (agentcore-runtime only; the Code Interpreter path was removed)" >&2; exit 1 ;;
esac
