# Sandbox tier: tier 2 (our own Runtime, generic stdlib image, VPC) by DEFAULT; tier 1 (managed Code Interpreter, no image) opt-in with SANDBOX=agentcore. See code/demos/README.md.
# demo_cpu_tasks — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
#
# SANDBOX picks the backend (same default as run.sh):
#   agentcore-runtime  (DEFAULT) our OWN sandbox Runtime (Dockerfile.sandbox.cpu, a stdlib-only microVM
#                      image, Runtime acs_tasks_cpu, networkMode=VPC so the in-session harness can dial
#                      the adapter back). Steps 1 … 6.
#   agentcore          the managed AgentCore Code Interpreter — no image, no ECR, no Runtime. Opt in:
#                      SANDBOX=agentcore; steps 2/3/4/6 are no-ops, run 1_prepare_data.sh then 5_run.sh.
SANDBOX="${SANDBOX:-agentcore-runtime}"
SUBSTRATE=microvm
PLATFORM=linux/arm64
IMAGES="${IMAGES:-cpu:Dockerfile.sandbox.cpu}"
REPO_PREFIX="${NAME_PREFIX}-tasks-"
RUNTIME_PREFIX="${NAME_PREFIX}_tasks_"
ARN_WIRING=arns          # cpu -> AGENTCORE_SANDBOX_RUNTIME_ARNS
PREPARE_POST="python3 $C_DEMO_DIR/verify_data.py"
DEFAULT_NOTE="baked shared K=2 acs_sandbox_cpu ARNs (SANDBOX=agentcore-runtime only)"

case "$SANDBOX" in
  agentcore|aws)
    # Managed Code Interpreter: nothing to build, push, deploy or delete. The hooks below short-circuit
    # steps 2/3/4/6 (4 writes an empty deploy/runtime.env, so a stale ARN from an earlier opt-in is dropped).
    IMAGES=""
    _NOOP='echo "default Code Interpreter: no image/Runtime needed (SANDBOX=$SANDBOX; opt in to your own with SANDBOX=agentcore-runtime)"'
    BUILD_CMD="$_NOOP"; PUSH_CMD="$_NOOP"; DEPLOY_CMD="$_NOOP"; CLEANUP_CMD="$_NOOP"
    DEFAULT_NOTE="SANDBOX=$SANDBOX = managed Code Interpreter, no ARN needed"
    export SANDBOX ;;
  agentcore-runtime|runtime)
    export SANDBOX ;;
  *) echo "!! demo_cpu_tasks: SANDBOX=$SANDBOX not supported (agentcore | agentcore-runtime)" >&2; exit 1 ;;
esac
