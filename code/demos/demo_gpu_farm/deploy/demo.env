# Sandbox tier: tier 3 (custom CUDA image, Ray GPU farm: local on GPU 6 / 6,7, or remote on a g6 Instance). See code/demos/README.md.
# demo_gpu_farm — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
# Two sites, ONE image and ONE /invocations contract (merged 2026-09-28 with demo_gpu_single):
#   LOCAL_GPU=1 (default): the farm on this host's GPUs (FARM=fractional: GPU 6 split 0.5+0.5;
#                          FARM=whole: GPUs 6,7, one whole GPU per sub_session)
#   LOCAL_GPU=0          : ONE warm g6 capacity-provider Instance, the same farm inside it
#                          (FARM=fractional: its L4 split 0.5+0.5; FARM=whole: the whole L4, 1 slot).
#                          Pass LOCAL_GPU=0 to EVERY step (2..6). The farm split is baked in at deploy,
#                          so changing FARM needs FORCE_RECREATE=1 bash 4_deploy_runtime.sh.
LOCAL_GPU="${LOCAL_GPU:-1}"
if [ "$LOCAL_GPU" = 1 ]; then SUBSTRATE=local-gpu; else SUBSTRATE=instance; fi
PLATFORM=linux/amd64
IMAGES="${IMAGES:-gpu:Dockerfile.sandbox.gpu.shared}"   # farm-capable server (SANDBOX=agentcore-ray-farm)
REPO_PREFIX="${NAME_PREFIX}-gpufarm-"
RUNTIME_PREFIX="${NAME_PREFIX}_gpufarm_"
ARN_WIRING=arn
LOCAL_FARM_MODE=fractional   # default; FARM=whole bash 4_deploy_runtime.sh for the whole-GPU variant
# Remote only. B4_FARM_GPUS must be explicit (python:slim has no nvidia-smi for Ray); g6.xlarge = 1 L4.
CP_NAME="${NAME_PREFIX}_gpu_cp"          # shared g6 capacity provider (kept on cleanup unless DELETE_CP=1)
case "${FARM:-$LOCAL_FARM_MODE}" in whole) _REMOTE_FRACTION=1.0 ;; *) _REMOTE_FRACTION=0.5 ;; esac
RUNTIME_ARGS=(--instance "${GPU_INSTANCE:-g6.xlarge}" --cp "$CP_NAME"
              --env B4_FARM_GPUS="${B4_FARM_GPUS:-1}" --env B4_GPU_FRACTION="${B4_GPU_FRACTION:-$_REMOTE_FRACTION}"
              --env B4_PER_SANDBOX_MEM_FRACTION="${B4_PER_SANDBOX_MEM_FRACTION:-$_REMOTE_FRACTION}"
              --env B4_WORKSPACE_ROOT=/workspace/b4-sbx --env B4_WARM_CUDA=1)
# Recorded in deploy/runtime.env by step 4, so a later LOCAL_GPU=0 bash 5_run.sh without FARM still gates
# the client to the slots this Runtime was deployed with (runtime.env wins over the caller's FARM).
RUNTIME_RECORD=("FARM=${FARM:-$LOCAL_FARM_MODE}")
