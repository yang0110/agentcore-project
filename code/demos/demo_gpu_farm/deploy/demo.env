# demo_gpu_farm — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
# LOCAL only: the shared-farm image served on this host's GPUs (FARM=fractional: GPU 6 split 0.5+0.5;
# FARM=whole: GPUs 6,7 one each). The same image deploys to a g6 unchanged (see demo_gpu_single).
SUBSTRATE=local-gpu
PLATFORM=linux/amd64
IMAGES="${IMAGES:-gpu:Dockerfile.sandbox.gpu.shared}"
REPO_PREFIX="${NAME_PREFIX}-gpufarm-"
RUNTIME_PREFIX="${NAME_PREFIX}_gpufarm_"
ARN_WIRING=arn
LOCAL_FARM_MODE=fractional   # FARM=whole bash 4_deploy_runtime.sh for the whole-GPU variant
