# Sandbox tier: tier 3 (custom CUDA image, local farm on GPUs 6,7). See code/demos/README.md.
# demo_gpu_farm_whole — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
# LOCAL only: the shared-farm image served on this host's GPUs (GPUs 6,7, one whole GPU per sub_session).
# The same image deploys to a g6 unchanged (see demo_gpu_single).
SUBSTRATE=local-gpu
PLATFORM=linux/amd64
IMAGES="${IMAGES:-gpu:Dockerfile.sandbox.gpu.shared}"
REPO_PREFIX="${NAME_PREFIX}-gpufarmwhole-"
RUNTIME_PREFIX="${NAME_PREFIX}_gpufarmwhole_"
ARN_WIRING=arn
LOCAL_FARM_MODE=whole   # hard-set: 4_deploy_runtime.sh runs run_local_gpu_runtime.sh whole
FARM=whole              # not a selector; pinned so an inherited FARM env var cannot flip the mode
