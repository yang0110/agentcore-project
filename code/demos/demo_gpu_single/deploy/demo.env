# demo_gpu_single — per-demo settings for the numbered step scripts (sourced by deploy/steps_common.sh).
#   SUBSTRATE   microvm (managed arm64 microVM) | instance (capacity-provider EC2, amd64) | local-gpu
#   IMAGES      "name:Dockerfile ..." built by 2_build_image.sh from deploy/ (context = this demo dir)
#   REPO_PREFIX / RUNTIME_PREFIX   ECR repo = ${REPO_PREFIX}<name>, Runtime = ${RUNTIME_PREFIX}<name>
#   ARN_WIRING  how 4_deploy_runtime.sh hands the ARN(s) to run.sh: arns | arn | by_image
# Two ways to run (same image, same /invocations contract):
#   remote (default): ONE warm g6 capacity-provider Instance, Ray GPU farm inside, per-episode sub_session
#   on-box:           LOCAL_GPU=1 bash 4_deploy_runtime.sh  -> local whole-GPU farm on host GPUs 6,7
SUBSTRATE=instance
PLATFORM=linux/amd64
IMAGES="${IMAGES:-gpu:Dockerfile.sandbox.gpu.shared}"   # farm-capable server (SANDBOX=agentcore-ray-farm)
REPO_PREFIX="${NAME_PREFIX}-gpusingle-"
RUNTIME_PREFIX="${NAME_PREFIX}_gpusingle_"
ARN_WIRING=arn
CP_NAME="${NAME_PREFIX}_gpu_cp"          # shared g6 capacity provider (kept on cleanup unless DELETE_CP=1)
# B4_FARM_GPUS must be explicit (python:slim has no nvidia-smi for Ray); 0.5 = 2 episodes per L4.
RUNTIME_ARGS=(--instance "${GPU_INSTANCE:-g6.xlarge}" --cp "$CP_NAME"
              --env B4_FARM_GPUS="${B4_FARM_GPUS:-1}" --env B4_GPU_FRACTION="${B4_GPU_FRACTION:-0.5}"
              --env B4_PER_SANDBOX_MEM_FRACTION="${B4_PER_SANDBOX_MEM_FRACTION:-0.5}"
              --env B4_WORKSPACE_ROOT=/workspace/b4-sbx --env B4_WARM_CUDA=1)
LOCAL_FARM_MODE=whole
